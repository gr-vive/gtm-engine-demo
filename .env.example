# Copy to .env. Everything runs without any of these set:
# the engine falls back to cached fixtures and dry-run outputs.

# --- AI layer -----------------------------------------------------------
# Anthropic API key. Without it, `gtm ai triage` uses cached fixtures
# (data/fixtures/triage/) or the deterministic mock provider.
ANTHROPIC_API_KEY=
# Model used for extraction and drafting. Any current Claude model id.
CLAUDE_MODEL=claude-opus-5
# shadow  = AI decides, logs, never acts; humans decide as before (default)
# assist  = AI drafts land in the review queue for a human to approve
# live    = not implemented on purpose: nothing goes to a customer unreviewed
AI_MODE=shadow
# Server-side refusal fallback (beta). Set to 1 to enable.
CLAUDE_FALLBACKS=0

# --- Audience sources ----------------------------------------------------
# Companies House public register (free). With a key, the discover stage pulls
# real solicitor firms (SIC 69102) and their officers; without it, mock sources.
# Register: https://developer.company-information.service.gov.uk/ → Create an application → REST API key
COMPANIES_HOUSE_API_KEY=

# --- Delivery (all optional, dry-run when empty) -------------------------
SLACK_WEBHOOK_URL=
SLACK_SIGNALS_WEBHOOK_URL=

# --- Pipeline caps --------------------------------------------------------
AUDIENCE_DAILY_PUSH_CAP=40
AUDIENCE_MIN_FIT_SCORE=7
ATTRIBUTION_LOOKBACK_DAYS=90

# --- Data -----------------------------------------------------------------
GTM_DB_PATH=data/gtm.db
SEED=20261008
